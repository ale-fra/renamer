{
  "name": "renamer",
  "description": "Rename files in bulk",
  "version": "6.0.0",
  "bin": {
    "renamer": "dist/bin/cli.js"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ale-fra/renamer.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "rename",
    "move",
    "mv",
    "file",
    "files",
    "bulk",
    "batch"
  ],
  "scripts": {
    "test": "node scripts/test.ts --typecheck",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test:run": "node scripts/test.ts",
    "prepack": "npm run build",
    "test:e2e": "npm run build && node test/e2e/cli.ts",
    "test:package": "node scripts/check-package.ts"
  },
  "dependencies": {
    "array-back": "^6.2.3",
    "chalk": "^5.6.2",
    "command-line-args": "^6.0.1",
    "command-line-usage": "^7.0.4",
    "fast-diff": "^1.3.0",
    "file-set": "^5.3.0",
    "global-directory": "^4.0.1",
    "load-module": "^5.0.0",
    "printj": "^1.3.1",
    "stream-read-all": "^5.0.2",
    "typical": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "renamer-case": "^2.0.2",
    "typescript": "7.0.2"
  },
  "author": "Lloyd Brookes <opensource@75lb.com>"
}
